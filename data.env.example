# Адрес уже установленной PNETLab Box на x86_64-хосте с KVM.
PNETLAB_HOST=192.0.2.10
PNETLAB_WEB_SCHEME=http
PNETLAB_SSH_USER=root
PNETLAB_SSH_PORT=22

# Выберите один способ SSH-аутентификации.
# PNETLAB_SSH_KEY=/absolute/path/to/private_key
# PNETLAB_SSH_PASSWORD=

# Учётные данные Eltex vESR для импорта и экспорта конфигурации.
VESR_USERNAME=change-me
VESR_PASSWORD=change-me

# Необязательно: подготовленный образ Eltex vESR.
# VESR_IMAGE=/workspace/images/vesr/hda.qcow2
